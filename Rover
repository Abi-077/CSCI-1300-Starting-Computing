#include <iostream>
#include <string>
#include <cstddef> //Lets us use size_t
using namespace std;

bool checkGoal(int x, int y, int goalX, int goalY) {
    return x == goalX && y == goalY;
}

bool roverIsReset(int x, int y, int battery) {
    return x == 0 && y == 0 && battery == 40;
}

void printMissionSummary(int x, int y, string direction,
                        int battery, int successfulCommands) {
    cout << "Mission Complete!" << endl;
    cout << "Rover ended at coordinates (" << x << "," << y
         << ") with heading " << direction
         << " and battery " << battery << "." << endl;
    cout << "Number of Successful Commands: "
         << successfulCommands << endl;
}

void printRoverStatus(int x, int y, string direction, int battery) {
    cout << "Current coordinates: (" << x << ", " << y << ") ";
    cout << "Heading: " << direction << " ";
    cout << "Battery: " << battery << endl;
}

void printGoalResetResult(bool goalReached, bool roverReset) {
    if (goalReached && roverReset)
        cout << "Goal reached and rover reset." << endl;
    else if (goalReached && !roverReset)
        cout << "Goal reached but rover not reset." << endl;
    else if (!goalReached && roverReset)
        cout << "Goal not reached but rover reset." << endl;
    else
        cout << "Goal not reached and rover not reset." << endl;
}

int main() {
    int x = 0;
    int y = 0;

    string direction = "East";
    int battery = 40;
    int succesfulCommands = 0;
    bool goalReached = false;
    int goalX = 0;
    int goalY = 0;
    string commands;
    bool running = true;
    
    while (running) {


    cout << "Input mission: ";
    cin >> commands;

    if (commands == "quit") {
        return 0;
    }

    cout << "Input goal x coordinate: ";
    cin >> goalX;
    cout << "Input goal y coordinate: ";
    cin >> goalY;

    succesfulCommands = 0;

    goalReached = checkGoal(x, y, goalX, goalY);


// size_t is a type for counting sizes, like the number of characters in a string.
// It matches the type returned by commands.length(), avoiding a comparison warning.
    for (size_t i = 0; i < commands.length(); i++) {
        char command = commands[i];
        bool commandWorked = false;

        if (command == 'F') {
            if (battery >= 2) {
                if (direction == "East") {
                    if ( x < 9) {
                    x = x + 1;
                    battery = battery - 2;
                    commandWorked = true;
                    }
                    else {
                        cout << "command F rejected: out of bounds" << endl;
                    }
                }
                else if (direction == "West") {
                    if ( x > 0) {
                    x = x - 1;
                    battery = battery - 2;
                    commandWorked = true;
                    }
                    else {
                        cout << "command F rejected: out of bounds" << endl;
                    }
                }
                else if (direction == "North") {
                    if ( y < 9) {
                    y = y + 1;
                    battery = battery - 2;
                    commandWorked = true;
                    }
                    else {
                        cout << "command F rejected: out of bounds" << endl;
                    }
                   
                }
                else if (direction == "South") {
                    if ( y > 0) {
                    y = y - 1;
                    battery = battery - 2;
                    commandWorked = true;
                    }
                    else {
                        cout << "command F rejected: out of bounds" << endl;
                    }
                }
            }
            else if (battery < 2) {
                cout << "command F rejected: insufficient battery" << endl;
            }

        }    

            else if (command == 'L') {
                if (battery >= 1) {
                    if (direction == "East") {
                        direction = "North";
                    }
                    else if (direction == "North") {
                        direction = "West";
                    }
                    else if (direction == "West") {
                        direction = "South";
                    }
                    else if (direction == "South") {
                        direction = "East";
                    }

                    battery = battery - 1;
                    commandWorked = true;
                }
                else if (battery < 1) {
                    cout << "command L rejected: insufficient battery" << endl;
                }
            }

            else if (command == 'R') {
                if (battery >=1 ) {
                    if (direction == "East") {
                        direction = "South";
                    }
                    else if (direction == "South") {
                        direction = "West";
                    }
                    else if (direction == "West") {
                        direction = "North";
                    }
                    else if (direction == "North") {
                        direction = "East";
                    }

                    battery = battery - 1;
                    commandWorked = true;
                }
                else if (battery < 1) {
                    cout << "command R rejected: insufficient battery" << endl;
                }
            }
            else if (command == 'S') {
                if (battery >= 3) {
                    battery = battery - 3;
                    commandWorked = true;
                }
                else if (battery < 3) {
                    cout << "command S rejected: insufficient battery" << endl;
                }
            }
            else if (command == 'C') {
                if ( x == 0 && y == 0) {
                    battery = 40;
                    commandWorked = true;
                }
                else {
                    cout << "command C rejected: not at charging station" << endl;
                }
            }
            else {
                cout << "command " << command << " rejected: invalid command" << endl;
            }

            if (commandWorked) {
                succesfulCommands = succesfulCommands + 1;
            }

           if (commandWorked) {
                cout << "Command " << command << " succeeded. ";
                printRoverStatus(x, y, direction, battery);
            }

            if (x == goalX && y == goalY) {
                goalReached = true;
            }
        
        
    }
    
    printMissionSummary(x, y, direction, battery, succesfulCommands);

    bool roverReset = roverIsReset(x, y, battery);

    printGoalResetResult(goalReached, roverReset);
    
}
    return 0;
}
